# ============================================================================
# Docker CI/CD Pipeline — generated by pipeforge
# ============================================================================
# Key design decisions:
#   • Hadolint catches Dockerfile anti-patterns before build (shift-left)
#   • Buildx with GHA cache backend for layer caching across runs
#   • Multi-platform builds (linux/amd64 + linux/arm64) by default
#   • Trivy scans the built image for OS + library CVEs
#   • Images are only pushed to the registry on main-branch pushes (not PRs)
#   • Docker Compose validation when hasCompose is true
#   • Semantic versioning via docker/metadata-action tag strategy
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
    tags:
      - "v*"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  workflow_dispatch:

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

permissions: read-all

env:
  REGISTRY: "{{dockerRegistry}}"
  IMAGE_NAME: "{{imageName}}"

jobs:
  # ── Dockerfile Lint ────────────────────────────────────────────────────────
  lint:
    name: "Lint Dockerfile"
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Hadolint checks Dockerfile best practices (e.g. pinned base images,
      # avoiding apt-get without --no-install-recommends, etc.)
      - name: Lint Dockerfile with Hadolint
        uses: hadolint/hadolint-action@v3.1.0
        with:
          dockerfile: Dockerfile
          # Treat DL3008 (apt pin versions) as warning since it's noisy
          ignore: DL3008
          failure-threshold: error

      {{#if hasCompose}}
      # Validate docker-compose file syntax and service configuration
      - name: Validate Docker Compose
        run: |
          docker compose config --quiet
          echo "✅ Docker Compose configuration is valid"

      - name: Check Compose service dependencies
        run: |
          # Ensure all depends_on services exist
          docker compose config --services
      {{/if}}

  # ── Build & Scan ───────────────────────────────────────────────────────────
  build:
    name: "Build & scan image"
    needs: [lint]
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      packages: write
      security-events: write
    outputs:
      image-digest: ${{"{{"}} steps.build.outputs.digest {{"}}"}}
      image-tags: ${{"{{"}} steps.meta.outputs.tags {{"}}"}}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # QEMU is needed for cross-platform builds (e.g. building arm64 on amd64)
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # Generate OCI-compliant labels and tags from Git context
      - name: Extract Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}
          tags: |
            # Branch name (e.g. main)
            type=ref,event=branch
            # PR number (e.g. pr-42)
            type=ref,event=pr
            # Semantic version from tags (e.g. 1.2.3)
            type=semver,pattern={{"{{"}}version{{"}}"}}
            type=semver,pattern={{"{{"}}major{{"}}"}}.{{"{{"}}minor{{"}}"}}
            # Git SHA (always unique)
            type=sha,prefix=sha-
            # Latest tag on default branch
            type=raw,value=latest,enable=${{"{{"}} github.ref == format('refs/heads/{0}', '{{defaultBranch}}') {{"}}"}}

      # Build the image locally first (load) for scanning before pushing
      - name: Build Docker image (local)
        id: build-local
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          load: true
          tags: ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}:ci-scan
          labels: ${{"{{"}} steps.meta.outputs.labels {{"}}"}}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            BUILD_DATE=${{"{{"}} github.event.head_commit.timestamp {{"}}"}}
            VCS_REF=${{"{{"}} github.sha {{"}}"}}

      # Trivy scans the image for known CVEs in OS packages and app dependencies
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}:ci-scan
          format: "sarif"
          output: "trivy-results.sarif"
          severity: "CRITICAL,HIGH"
          # Exit 1 on critical vulnerabilities to fail the pipeline
          exit-code: "1"
          ignore-unfixed: true

      - name: Upload Trivy SARIF to GitHub Security
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy-results.sarif
        continue-on-error: true

      # Also produce a human-readable table for the job summary
      - name: Trivy summary (table)
        if: always()
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}:ci-scan
          format: "table"
          severity: "CRITICAL,HIGH,MEDIUM"
          ignore-unfixed: true

      # Authenticate to registry only when we intend to push
      - name: Log in to container registry
        if: github.event_name == 'push'
        uses: docker/login-action@v3
        with:
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: ${{"{{"}} secrets.DOCKER_USERNAME {{"}}"}}
          password: ${{"{{"}} secrets.DOCKER_PASSWORD {{"}}"}}

      # Multi-platform build + push (only on push events)
      - name: Build and push Docker image
        id: build
        if: github.event_name == 'push'
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          platforms: linux/amd64,linux/arm64
          tags: ${{"{{"}} steps.meta.outputs.tags {{"}}"}}
          labels: ${{"{{"}} steps.meta.outputs.labels {{"}}"}}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          build-args: |
            BUILD_DATE=${{"{{"}} github.event.head_commit.timestamp {{"}}"}}
            VCS_REF=${{"{{"}} github.sha {{"}}"}}
          provenance: true
          sbom: true

  {{#if hasCompose}}
  # ── Integration Test (Compose) ─────────────────────────────────────────────
  integration-test:
    name: "Integration test (Compose)"
    needs: [build]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Start services
        run: |
          docker compose up -d --wait --wait-timeout 60

      - name: Run health checks
        run: |
          # Wait for services to be healthy
          sleep 10
          docker compose ps --format json | jq -e '.[] | select(.Health != "healthy" and .Health != "") | halt_error(1)'
          echo "✅ All services are healthy"

      - name: Run integration tests
        run: |
          # ── Replace with your integration test command ──
          docker compose exec -T app echo "Integration tests would run here"

      - name: Collect logs on failure
        if: failure()
        run: docker compose logs --tail=100

      - name: Tear down services
        if: always()
        run: docker compose down -v --remove-orphans
  {{/if}}

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging"
    needs: [build{{#if hasCompose}}, integration-test{{/if}}]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Deploy to staging
        id: deploy
        env:
          IMAGE_DIGEST: ${{"{{"}} needs.build.outputs.image-digest {{"}}"}}
        run: |
          echo "::notice::Deploying ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}@${IMAGE_DIGEST} to staging"
          # ── Replace with your deployment command ──
          # e.g. kubectl set image deployment/{{name}} app=$REGISTRY/$IMAGE_NAME@$IMAGE_DIGEST
          # e.g. docker compose -f docker-compose.staging.yml up -d
          echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production ───────────────────────────────────────────────────
  deploy-production:
    name: "Deploy → Production"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Deploy to production
        id: deploy
        env:
          IMAGE_DIGEST: ${{"{{"}} needs.build.outputs.image-digest {{"}}"}}
        run: |
          echo "::notice::Deploying ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}@${IMAGE_DIGEST} to production"
          # ── Replace with your deployment command ──
          echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"
  {{/if}}
