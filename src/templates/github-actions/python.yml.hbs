# ============================================================================
# Python CI/CD Pipeline — generated by ciraft
# ============================================================================
# Key design decisions:
#   • Matrix across Python versions to catch deprecation / compat issues early
#   • pip cache keyed on requirements hash; poetry/pipenv have their own caches
#   • Dual linting: ruff (fast, Rust-based) + flake8 for broad plugin ecosystem
#   • Type checking with mypy runs in a separate job to avoid slowing tests
#   • Security: bandit for SAST, safety for dependency CVEs
#   • Framework-specific test configuration (Django / Flask / FastAPI)
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  workflow_dispatch:

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

permissions: read-all

env:
  DEFAULT_PYTHON: "{{defaultPythonVersion}}"
  {{#if (eq packageManager "poetry")}}
  POETRY_VIRTUALENVS_IN_PROJECT: "true"
  {{/if}}

jobs:
  # ── Lint ───────────────────────────────────────────────────────────────────
  lint:
    name: "Lint & format"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}
          {{#if (eq packageManager "pip")}}
          cache: "pip"
          {{/if}}

      {{#if (eq packageManager "poetry")}}
      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry venv
        uses: actions/cache@v4
        with:
          path: .venv
          key: venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-${{"{{"}} hashFiles('**/poetry.lock') {{"}}"}}
          restore-keys: |
            venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-
      {{/if}}

      {{#if (eq packageManager "pipenv")}}
      - name: Cache Pipenv virtualenv
        uses: actions/cache@v4
        with:
          path: ~/.local/share/virtualenvs
          key: pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-${{"{{"}} hashFiles('**/Pipfile.lock') {{"}}"}}
          restore-keys: |
            pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-
      {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "pip")}}
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt
          {{/if}}
          {{#if (eq packageManager "poetry")}}
          poetry install --no-interaction --no-ansi
          {{/if}}
          {{#if (eq packageManager "pipenv")}}
          pip install pipenv
          pipenv install --dev --deploy
          {{/if}}

      # Ruff is ~100x faster than flake8; use it as primary linter
      - name: Lint with ruff
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run ruff check . --output-format=github
          poetry run ruff format --check .
          {{else if (eq packageManager "pipenv")}}
          pipenv run ruff check . --output-format=github
          pipenv run ruff format --check .
          {{else}}
          ruff check . --output-format=github
          ruff format --check .
          {{/if}}

      # Flake8 provides broader plugin coverage (e.g. flake8-bugbear)
      - name: Lint with flake8
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run flake8 . --count --show-source --statistics
          {{else if (eq packageManager "pipenv")}}
          pipenv run flake8 . --count --show-source --statistics
          {{else}}
          flake8 . --count --show-source --statistics
          {{/if}}

  # ── Type Check ─────────────────────────────────────────────────────────────
  type-check:
    name: "Type check (mypy)"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}
          {{#if (eq packageManager "pip")}}
          cache: "pip"
          {{/if}}

      {{#if (eq packageManager "poetry")}}
      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry venv
        uses: actions/cache@v4
        with:
          path: .venv
          key: venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-${{"{{"}} hashFiles('**/poetry.lock') {{"}}"}}
          restore-keys: |
            venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-
      {{/if}}

      {{#if (eq packageManager "pipenv")}}
      - name: Cache Pipenv virtualenv
        uses: actions/cache@v4
        with:
          path: ~/.local/share/virtualenvs
          key: pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-${{"{{"}} hashFiles('**/Pipfile.lock') {{"}}"}}
          restore-keys: |
            pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}-
      {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "pip")}}
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt
          {{/if}}
          {{#if (eq packageManager "poetry")}}
          poetry install --no-interaction --no-ansi
          {{/if}}
          {{#if (eq packageManager "pipenv")}}
          pip install pipenv
          pipenv install --dev --deploy
          {{/if}}

      - name: Run mypy
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run mypy . --ignore-missing-imports
          {{else if (eq packageManager "pipenv")}}
          pipenv run mypy . --ignore-missing-imports
          {{else}}
          mypy . --ignore-missing-imports
          {{/if}}

  # ── Test ───────────────────────────────────────────────────────────────────
  test:
    name: "Test (Python ${{"{{"}} matrix.python-version {{"}}"}})"
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        python-version: [{{#each pythonVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    {{#if hasDjango}}
    services:
      # Django projects typically need a database
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: testuser
          POSTGRES_PASSWORD: testpass
          POSTGRES_DB: testdb
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    {{/if}}
    {{#if hasFastAPI}}
    services:
      # FastAPI apps commonly use Redis for caching / task queues
      redis:
        image: redis:7
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    {{/if}}
    env:
      {{#if hasDjango}}
      DATABASE_URL: "postgresql://testuser:testpass@localhost:5432/testdb"
      DJANGO_SETTINGS_MODULE: "{{name}}.settings.test"
      {{/if}}
      {{#if hasFlask}}
      FLASK_ENV: "testing"
      {{/if}}
      {{#if hasFastAPI}}
      TESTING: "1"
      {{/if}}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python ${{"{{"}} matrix.python-version {{"}}"}}
        uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} matrix.python-version {{"}}"}}
          {{#if (eq packageManager "pip")}}
          cache: "pip"
          {{/if}}

      {{#if (eq packageManager "poetry")}}
      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry venv
        uses: actions/cache@v4
        with:
          path: .venv
          key: venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} matrix.python-version {{"}}"}}-${{"{{"}} hashFiles('**/poetry.lock') {{"}}"}}
          restore-keys: |
            venv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} matrix.python-version {{"}}"}}-
      {{/if}}

      {{#if (eq packageManager "pipenv")}}
      - name: Cache Pipenv virtualenv
        uses: actions/cache@v4
        with:
          path: ~/.local/share/virtualenvs
          key: pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} matrix.python-version {{"}}"}}-${{"{{"}} hashFiles('**/Pipfile.lock') {{"}}"}}
          restore-keys: |
            pipenv-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} matrix.python-version {{"}}"}}-
      {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "pip")}}
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt
          {{/if}}
          {{#if (eq packageManager "poetry")}}
          poetry install --no-interaction --no-ansi
          {{/if}}
          {{#if (eq packageManager "pipenv")}}
          pip install pipenv
          pipenv install --dev --deploy
          {{/if}}

      {{#if hasDjango}}
      - name: Run Django migrations
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run python manage.py migrate --no-input
          {{else if (eq packageManager "pipenv")}}
          pipenv run python manage.py migrate --no-input
          {{else}}
          python manage.py migrate --no-input
          {{/if}}
      {{/if}}

      - name: Run tests with coverage
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run pytest --cov --cov-report=xml --cov-report=html -v
          {{else if (eq packageManager "pipenv")}}
          pipenv run pytest --cov --cov-report=xml --cov-report=html -v
          {{else}}
          pytest --cov --cov-report=xml --cov-report=html -v
          {{/if}}

      - name: Upload coverage report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-py${{"{{"}} matrix.python-version {{"}}"}}
          path: |
            coverage.xml
            htmlcov/
          retention-days: 7

  # ── Security ───────────────────────────────────────────────────────────────
  security:
    name: "Security scan"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    continue-on-error: true
    permissions:
      security-events: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}
          {{#if (eq packageManager "pip")}}
          cache: "pip"
          {{/if}}

      {{#if (eq packageManager "poetry")}}
      - name: Install Poetry
        uses: snok/install-poetry@v1

      - name: Install dependencies
        run: poetry install --no-interaction --no-ansi
      {{else if (eq packageManager "pipenv")}}
      - name: Install dependencies
        run: |
          pip install pipenv
          pipenv install --dev --deploy
      {{else}}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt
          pip install bandit safety
      {{/if}}

      # Bandit: static analysis for common security issues in Python code
      - name: Run Bandit (SAST)
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run bandit -r . -f sarif -o bandit-results.sarif --exclude ./tests,./.venv || true
          {{else if (eq packageManager "pipenv")}}
          pipenv run bandit -r . -f sarif -o bandit-results.sarif --exclude ./tests || true
          {{else}}
          bandit -r . -f sarif -o bandit-results.sarif --exclude ./tests || true
          {{/if}}

      - name: Upload Bandit SARIF
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: bandit-results.sarif
        continue-on-error: true

      # Safety: check installed packages against known-vulnerability database
      - name: Run Safety (dependency CVE check)
        run: |
          {{#if (eq packageManager "poetry")}}
          poetry run safety check --full-report
          {{else if (eq packageManager "pipenv")}}
          pipenv run safety check --full-report
          {{else}}
          safety check --full-report -r requirements.txt
          {{/if}}
        continue-on-error: true

  # ── Build ──────────────────────────────────────────────────────────────────
  build:
    name: "Build distribution"
    needs: [lint, type-check, test]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{"{{"}} env.DEFAULT_PYTHON {{"}}"}}

      - name: Build package
        run: |
          {{#if (eq packageManager "poetry")}}
          pip install poetry
          poetry build
          {{else}}
          pip install build
          python -m build
          {{/if}}

      - name: Upload dist artifacts
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/
          retention-days: 5

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging"
    needs: [build, security]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download dist
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - name: Deploy to staging
        id: deploy
        run: |
          echo "::notice::Deploying {{name}} to staging"
          # ── Replace with your deployment command ──
          # e.g. twine upload --repository staging dist/*
          # e.g. gcloud run deploy --tag staging
          echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production ───────────────────────────────────────────────────
  deploy-production:
    name: "Deploy → Production"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download dist
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - name: Deploy to production
        id: deploy
        run: |
          echo "::notice::Deploying {{name}} to production"
          # ── Replace with your deployment command ──
          # e.g. twine upload dist/*
          # e.g. gcloud run deploy --tag production
          echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"
  {{/if}}
