# ============================================================================
# Node.js CI/CD Pipeline — generated by pipeforge
# ============================================================================
# Key design decisions:
#   • Matrix strategy across Node versions for compatibility assurance
#   • Aggressive dependency caching keyed on lockfile hash
#   • Security audit baked into every CI run (shift-left security)
#   • Concurrency groups cancel redundant runs on the same branch/PR
#   • Least-privilege permissions with targeted overrides per job
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    # Ignore changes that cannot affect build output
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  # Allow manual trigger for ad-hoc runs / hotfixes
  workflow_dispatch:

# Cancel any in-progress run for the same branch / PR to save runner minutes
concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

# Default: read-only. Jobs that need more will override.
permissions: read-all

env:
  # Centralise the Node version used outside the matrix (deploy jobs, etc.)
  DEFAULT_NODE_VERSION: "{{defaultNodeVersion}}"
  {{#if (eq packageManager "pnpm")}}
  PNPM_VERSION: "{{pnpmVersion}}"
  {{/if}}

# ──────────────────────────────────────────────────────────────────────────────
# CI Jobs
# ──────────────────────────────────────────────────────────────────────────────

jobs:
  # ── Install & Cache ────────────────────────────────────────────────────────
  install:
    name: "Install dependencies"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      matrix:
        node-version: [{{#each nodeVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#if (eq packageManager "pnpm")}}
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{"{{"}} env.PNPM_VERSION {{"}}"}}
      {{/if}}

      - name: Setup Node.js ${{"{{"}} matrix.node-version {{"}}"}}
        uses: actions/setup-node@v4
        with:
          node-version: ${{"{{"}} matrix.node-version {{"}}"}}
          {{#if (eq packageManager "npm")}}
          cache: "npm"
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          cache: "yarn"
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          cache: "pnpm"
          {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "npm")}}
          npm ci --prefer-offline
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn install --frozen-lockfile
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm install --frozen-lockfile
          {{/if}}

  {{#if hasLint}}
  # ── Lint ───────────────────────────────────────────────────────────────────
  lint:
    name: "Lint"
    needs: [install]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      matrix:
        node-version: [{{#each nodeVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#if (eq packageManager "pnpm")}}
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{"{{"}} env.PNPM_VERSION {{"}}"}}
      {{/if}}

      - name: Setup Node.js ${{"{{"}} matrix.node-version {{"}}"}}
        uses: actions/setup-node@v4
        with:
          node-version: ${{"{{"}} matrix.node-version {{"}}"}}
          {{#if (eq packageManager "npm")}}
          cache: "npm"
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          cache: "yarn"
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          cache: "pnpm"
          {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "npm")}}
          npm ci --prefer-offline
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn install --frozen-lockfile
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm install --frozen-lockfile
          {{/if}}

      - name: Run linter
        run: |
          {{#if (eq packageManager "npm")}}
          npm run lint
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn lint
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm lint
          {{/if}}

      {{#if hasTypeScript}}
      # Type-checking is separate from compilation — catches type-only errors
      - name: Run type check
        run: |
          {{#if (eq packageManager "npm")}}
          npx tsc --noEmit
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn tsc --noEmit
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm tsc --noEmit
          {{/if}}
      {{/if}}
  {{/if}}

  {{#if hasTests}}
  # ── Test ───────────────────────────────────────────────────────────────────
  test:
    name: "Test"
    needs: [install]
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        node-version: [{{#each nodeVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#if (eq packageManager "pnpm")}}
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{"{{"}} env.PNPM_VERSION {{"}}"}}
      {{/if}}

      - name: Setup Node.js ${{"{{"}} matrix.node-version {{"}}"}}
        uses: actions/setup-node@v4
        with:
          node-version: ${{"{{"}} matrix.node-version {{"}}"}}
          {{#if (eq packageManager "npm")}}
          cache: "npm"
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          cache: "yarn"
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          cache: "pnpm"
          {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "npm")}}
          npm ci --prefer-offline
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn install --frozen-lockfile
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm install --frozen-lockfile
          {{/if}}

      - name: Run tests with coverage
        run: |
          {{#if (eq packageManager "npm")}}
          npm test -- --coverage --ci
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn test --coverage --ci
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm test -- --coverage --ci
          {{/if}}

      - name: Upload coverage report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-node-${{"{{"}} matrix.node-version {{"}}"}}
          path: coverage/
          retention-days: 7
  {{/if}}

  # ── Build ──────────────────────────────────────────────────────────────────
  build:
    name: "Build"
    needs: [{{#if hasLint}}lint{{/if}}{{#if hasTests}}{{#if hasLint}}, {{/if}}test{{/if}}]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#if (eq packageManager "pnpm")}}
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{"{{"}} env.PNPM_VERSION {{"}}"}}
      {{/if}}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{"{{"}} env.DEFAULT_NODE_VERSION {{"}}"}}
          {{#if (eq packageManager "npm")}}
          cache: "npm"
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          cache: "yarn"
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          cache: "pnpm"
          {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "npm")}}
          npm ci --prefer-offline
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn install --frozen-lockfile
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm install --frozen-lockfile
          {{/if}}

      - name: Build
        run: |
          {{#if (eq packageManager "npm")}}
          npm run build
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn build
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm build
          {{/if}}

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: |
            dist/
            build/
          retention-days: 5

  # ── Security ───────────────────────────────────────────────────────────────
  security:
    name: "Security audit"
    needs: [install]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    # Security findings should not block PRs but should be visible
    continue-on-error: true
    permissions:
      security-events: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#if (eq packageManager "pnpm")}}
      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: ${{"{{"}} env.PNPM_VERSION {{"}}"}}
      {{/if}}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{"{{"}} env.DEFAULT_NODE_VERSION {{"}}"}}
          {{#if (eq packageManager "npm")}}
          cache: "npm"
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          cache: "yarn"
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          cache: "pnpm"
          {{/if}}

      - name: Install dependencies
        run: |
          {{#if (eq packageManager "npm")}}
          npm ci --prefer-offline
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn install --frozen-lockfile
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm install --frozen-lockfile
          {{/if}}

      - name: Run dependency audit
        run: |
          {{#if (eq packageManager "npm")}}
          npm audit --audit-level=high
          {{/if}}
          {{#if (eq packageManager "yarn")}}
          yarn audit --level high
          {{/if}}
          {{#if (eq packageManager "pnpm")}}
          pnpm audit --audit-level high
          {{/if}}

      # Detect known-vulnerable patterns in first-party code
      - name: Run njsscan (SAST)
        uses: ajinabraham/njsscan-action@v7
        with:
          args: "--sarif --output results.sarif . || true"

      - name: Upload SARIF
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: results.sarif
        continue-on-error: true

  {{#if hasDocker}}
  # ── Docker Build & Scan ────────────────────────────────────────────────────
  docker:
    name: "Docker build & scan"
    needs: [build]
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      packages: write
      security-events: write
    env:
      IMAGE_NAME: {{dockerRegistry}}/{{imageName}}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: build-output
          path: dist/

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{"{{"}} env.IMAGE_NAME {{"}}"}}
          tags: |
            type=sha,prefix={{name}}-
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{"{{"}}version{{"}}"}}

      - name: Build Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          load: true
          tags: ${{"{{"}} steps.meta.outputs.tags {{"}}"}}
          labels: ${{"{{"}} steps.meta.outputs.labels {{"}}"}}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Trivy catches OS-package and app-dependency CVEs in the built image
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: ${{"{{"}} env.IMAGE_NAME {{"}}"}}:${{"{{"}} steps.meta.outputs.version {{"}}"}}
          format: "sarif"
          output: "trivy-results.sarif"
          severity: "CRITICAL,HIGH"

      - name: Upload Trivy results to GitHub Security
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy-results.sarif
        continue-on-error: true

      # Only push on main-branch commits (not PRs)
      - name: Log in to container registry
        if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
        uses: docker/login-action@v3
        with:
          registry: {{dockerRegistry}}
          username: ${{"{{"}} secrets.DOCKER_USERNAME {{"}}"}}
          password: ${{"{{"}} secrets.DOCKER_PASSWORD {{"}}"}}

      - name: Push Docker image
        if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{"{{"}} steps.meta.outputs.tags {{"}}"}}
          labels: ${{"{{"}} steps.meta.outputs.labels {{"}}"}}
          cache-from: type=gha
          cache-to: type=gha,mode=max
  {{/if}}

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging"
    needs: [build, security{{#if hasDocker}}, docker{{/if}}]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write          # OIDC for cloud provider auth
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: build-output
          path: dist/

      - name: Deploy to staging
        id: deploy
        run: |
          echo "::notice::Deploying {{name}} to staging environment"
          # ── Replace with your deployment command ──
          # e.g. aws s3 sync dist/ s3://staging-bucket/
          # e.g. kubectl apply -k overlays/staging/
          echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production (manual gate) ─────────────────────────────────────
  deploy-production:
    name: "Deploy → Production"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # The 'production' environment MUST have a required-reviewer rule
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: build-output
          path: dist/

      - name: Deploy to production
        id: deploy
        run: |
          echo "::notice::Deploying {{name}} to production environment"
          # ── Replace with your deployment command ──
          # e.g. aws s3 sync dist/ s3://prod-bucket/
          # e.g. kubectl apply -k overlays/production/
          echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"
  {{/if}}
