# ============================================================================
# Swift CI/CD Pipeline — generated by ciraft
# ============================================================================

name: Swift CI

on:
  push:
    branches: [{{#each branches}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}]
  pull_request:
    branches: [{{#each branches}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}]
  workflow_dispatch:

{{#if enableConcurrency}}
concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

{{/if}}
permissions:
  contents: read

env:
  SWIFT_VERSION: '{{swiftVersion}}'
  XCODE_VERSION: '{{xcodeVersion}}'
  XCODE_PROJECT: '{{xcodeProject}}'
  XCODE_WORKSPACE: '{{xcodeWorkspace}}'
  XCODE_SCHEME: '{{xcodeScheme}}'
  XCODE_DESTINATION: 'platform=iOS Simulator,name=iPhone 15'

jobs:
  build:
    name: Build & Test (Swift)
    runs-on: macos-latest
    timeout-minutes: {{timeout}}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: ${{"{{"}} env.XCODE_VERSION {{"}}"}}

      - name: Show toolchain versions
        run: |
          swift --version
          xcodebuild -version

{{#if swiftHasPackage}}
      - name: Resolve Swift package dependencies
        run: swift package resolve

      - name: Build Swift package
        run: swift build

      - name: Test Swift package
        run: swift test
{{else}}
      - name: List Xcode schemes
        run: |
          if [ -n "$XCODE_WORKSPACE" ]; then
            xcodebuild -list -workspace "$XCODE_WORKSPACE"
          else
            xcodebuild -list -project "$XCODE_PROJECT"
          fi

      - name: Build and test Xcode project
        run: |
          set -euo pipefail

          if [ -n "$XCODE_WORKSPACE" ]; then
            xcodebuild test \
              -workspace "$XCODE_WORKSPACE" \
              -scheme "$XCODE_SCHEME" \
              -destination "$XCODE_DESTINATION"
          else
            xcodebuild test \
              -project "$XCODE_PROJECT" \
              -scheme "$XCODE_SCHEME" \
              -destination "$XCODE_DESTINATION"
          fi
{{/if}}
