# ============================================================================
# Go CI/CD Pipeline — generated by ciraft
# ============================================================================
# Key design decisions:
#   • Go module cache + build cache reduce rebuild times dramatically
#   • Race-detector tests (-race) catch data races that regular tests miss
#   • golangci-lint runs 50+ linters in a single pass; pinned for stability
#   • govulncheck uses the Go vulnerability database (vuln.go.dev)
#   • GoReleaser automates cross-compiled release artifacts
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
    tags:
      - "v*"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  workflow_dispatch:

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

permissions: read-all

env:
  # Used by jobs that don't run the full matrix
  DEFAULT_GO_VERSION: "{{defaultGoVersion}}"

jobs:
  # ── Vet & Lint ─────────────────────────────────────────────────────────────
  lint:
    name: "Vet & lint"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      matrix:
        go-version: [{{#each goVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Go ${{"{{"}} matrix.go-version {{"}}"}}
        uses: actions/setup-go@v5
        with:
          go-version: ${{"{{"}} matrix.go-version {{"}}"}}
          # setup-go@v5 automatically caches ~/go/pkg/mod and ~/.cache/go-build

      - name: Download modules
        run: go mod download

      - name: Verify module checksums
        run: go mod verify

      # go vet catches issues the compiler doesn't (printf format strings, etc.)
      - name: Run go vet
        run: go vet ./...

      # golangci-lint aggregates 50+ linters — much faster than running each one
      - name: Run golangci-lint
        uses: golangci/golangci-lint-action@v6
        with:
          version: latest
          args: --timeout=5m

  # ── Test ───────────────────────────────────────────────────────────────────
  test:
    name: "Test (Go ${{"{{"}} matrix.go-version {{"}}"}})"
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        go-version: [{{#each goVersions}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Go ${{"{{"}} matrix.go-version {{"}}"}}
        uses: actions/setup-go@v5
        with:
          go-version: ${{"{{"}} matrix.go-version {{"}}"}}

      - name: Download modules
        run: go mod download

      # -race enables the data-race detector (CGO required, enabled by default on Linux)
      # -coverprofile captures code coverage in a single pass
      - name: Run tests with race detector and coverage
        run: |
          go test -v -race -coverprofile=coverage.out -covermode=atomic ./...

      - name: Generate coverage report
        run: go tool cover -html=coverage.out -o coverage.html

      - name: Upload coverage artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-go${{"{{"}} matrix.go-version {{"}}"}}
          path: |
            coverage.out
            coverage.html
          retention-days: 7

  # ── Build ──────────────────────────────────────────────────────────────────
  build:
    name: "Build"
    needs: [lint, test]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      matrix:
        goos: [linux, darwin, windows]
        goarch: [amd64, arm64]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{"{{"}} env.DEFAULT_GO_VERSION {{"}}"}}

      - name: Download modules
        run: go mod download

      - name: Build binary
        env:
          GOOS: ${{"{{"}} matrix.goos {{"}}"}}
          GOARCH: ${{"{{"}} matrix.goarch {{"}}"}}
          CGO_ENABLED: "0"
        run: |
          BINARY_NAME="{{name}}-${{"{{"}} matrix.goos {{"}}"}}-${{"{{"}} matrix.goarch {{"}}"}}"
          if [ "${{"{{"}} matrix.goos {{"}}"}}" = "windows" ]; then
            BINARY_NAME="${BINARY_NAME}.exe"
          fi
          go build -ldflags="-s -w -X main.version=${{"{{"}} github.sha {{"}}"}}" -o "bin/${BINARY_NAME}" ./...

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: binary-${{"{{"}} matrix.goos {{"}}"}}-${{"{{"}} matrix.goarch {{"}}"}}
          path: bin/
          retention-days: 5

  # ── Security ───────────────────────────────────────────────────────────────
  security:
    name: "Security scan"
    needs: [lint]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    continue-on-error: true
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{"{{"}} env.DEFAULT_GO_VERSION {{"}}"}}

      # govulncheck queries vuln.go.dev — Go's official vulnerability database
      - name: Install govulncheck
        run: go install golang.org/x/vuln/cmd/govulncheck@latest

      - name: Run govulncheck
        run: govulncheck ./...

      # gosec finds security issues via AST analysis
      - name: Run gosec
        uses: securego/gosec@master
        with:
          args: "-no-fail -fmt sarif -out gosec-results.sarif ./..."

      - name: Upload SARIF results
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: gosec-results.sarif
        continue-on-error: true

  {{#if hasGoreleaser}}
  # ── Release (GoReleaser) ───────────────────────────────────────────────────
  release:
    name: "Release (GoReleaser)"
    needs: [build, security]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write    # Create GitHub releases
      packages: write    # Push container images if configured
      id-token: write    # Sign artifacts with cosign
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0   # GoReleaser needs full history for changelogs

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{"{{"}} env.DEFAULT_GO_VERSION {{"}}"}}

      - name: Run GoReleaser
        uses: goreleaser/goreleaser-action@v6
        with:
          distribution: goreleaser
          version: "~> v2"
          args: release --clean
        env:
          GITHUB_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
  {{/if}}

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging"
    needs: [build, security]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: binary-linux-amd64
          path: bin/

      - name: Deploy to staging
        id: deploy
        run: |
          chmod +x bin/*
          echo "::notice::Deploying {{name}} to staging environment"
          # ── Replace with your deployment command ──
          # e.g. scp bin/{{name}}-linux-amd64 staging-server:/opt/{{name}}/
          # e.g. kubectl set image deployment/{{name}} app={{name}}:$GITHUB_SHA
          echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production ───────────────────────────────────────────────────
  deploy-production:
    name: "Deploy → Production"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: binary-linux-amd64
          path: bin/

      - name: Deploy to production
        id: deploy
        run: |
          chmod +x bin/*
          echo "::notice::Deploying {{name}} to production environment"
          # ── Replace with your deployment command ──
          echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"
  {{/if}}
