# ============================================================================
# Composite (Multi-Stack) CI/CD Pipeline — generated by ciraft
# ============================================================================
# Key design decisions:
#   • Uses the reusable-workflow pattern: each stack calls its own workflow
#     file, keeping this orchestrator clean and maintainable
#   • All stack workflows run in parallel for fast feedback
#   • Security scanning is a dedicated gate — every stack must pass it
#   • A single deployment pipeline runs after ALL stacks pass (not per-stack)
#   • Concurrency groups prevent duplicate runs across the whole pipeline
#   • Each called workflow inherits only the secrets it needs
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  workflow_dispatch:

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

permissions: read-all

jobs:
  # ── Change Detection ───────────────────────────────────────────────────────
  # Only run stack-specific workflows when their files actually changed.
  # This avoids wasting CI minutes on unrelated changes.
  detect-changes:
    name: "Detect changed paths"
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      {{#each stacks}}
      {{this.id}}-changed: ${{"{{"}} steps.filter.outputs.{{this.id}} {{"}}"}}
      {{/each}}
      docker-changed: ${{"{{"}} steps.filter.outputs.docker {{"}}"}}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Detect file changes
        id: filter
        uses: dorny/paths-filter@v3
        with:
          filters: |
            {{#each stacks}}
            {{this.id}}:
              - '{{this.pathFilter}}'
            {{/each}}
            docker:
              - 'Dockerfile*'
              - 'docker-compose*.yml'
              - '.dockerignore'

  {{#each stacks}}
  # ── {{this.name}} Stack ──────────────────────────────────────────────────────
  {{this.id}}-ci:
    name: "{{this.name}} CI"
    needs: [detect-changes]
    if: needs.detect-changes.outputs.{{this.id}}-changed == 'true' || github.event_name == 'workflow_dispatch'
    uses: ./.github/workflows/{{this.workflowFile}}
    with:
      {{#if this.workingDirectory}}
      working-directory: "{{this.workingDirectory}}"
      {{/if}}
      {{#if this.versions}}
      versions: '{{json this.versions}}'
      {{/if}}
    secrets: inherit

  {{/each}}

  {{#if hasDocker}}
  # ── Docker Build & Scan ────────────────────────────────────────────────────
  docker-ci:
    name: "Docker CI"
    needs: [detect-changes]
    if: needs.detect-changes.outputs.docker-changed == 'true' || github.event_name == 'workflow_dispatch'
    uses: ./.github/workflows/docker.yml
    with:
      registry: "{{dockerRegistry}}"
      image-name: "{{imageName}}"
    secrets: inherit
  {{/if}}

  # ── Aggregate Security Gate ────────────────────────────────────────────────
  # All stacks must pass before deployment can proceed.
  # This job collects results from all parallel CI jobs.
  security-gate:
    name: "Security gate"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs:
      {{#each stacks}}
      - {{this.id}}-ci
      {{/each}}
      {{#if hasDocker}}
      - docker-ci
      {{/if}}
    # Run even if upstream jobs were skipped (change-detection filtered them out)
    if: |
      always() &&
      !contains(needs.*.result, 'failure') &&
      !contains(needs.*.result, 'cancelled')
    permissions:
      security-events: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Aggregate security results
        run: |
          echo "## Security Gate Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          {{#each stacks}}
          echo "- **{{this.name}}**: ${{"{{"}} needs.{{this.id}}-ci.result {{"}}"}}" >> "$GITHUB_STEP_SUMMARY"
          {{/each}}
          {{#if hasDocker}}
          echo "- **Docker**: ${{"{{"}} needs.docker-ci.result {{"}}"}}" >> "$GITHUB_STEP_SUMMARY"
          {{/if}}
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "✅ All security checks passed" >> "$GITHUB_STEP_SUMMARY"

      # Run a final dependency license check across the entire repo
      - name: License compliance check
        run: |
          echo "::notice::License compliance check placeholder"
          # ── Replace with your license scanner ──
          # e.g. npx license-checker --failOn 'GPL-3.0'
          # e.g. pip-licenses --fail-on 'GPL-3.0'

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging (all stacks)"
    needs: [security-gate]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#each stacks}}
      - name: Deploy {{this.name}} to staging
        run: |
          echo "::notice::Deploying {{this.name}} stack to staging"
          # ── Replace with your {{this.name}} deployment command ──
          {{#if this.deployCommand}}
          {{this.deployCommand}} --env staging
          {{/if}}

      {{/each}}
      {{#if hasDocker}}
      - name: Deploy Docker services to staging
        run: |
          echo "::notice::Deploying Docker services to staging"
          # ── Replace with your Docker deployment command ──
          # e.g. docker compose -f docker-compose.staging.yml up -d
          # e.g. kubectl apply -k overlays/staging/
      {{/if}}

      - name: Set staging URL
        id: deploy
        run: echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production ───────────────────────────────────────────────────
  deploy-production:
    name: "Deploy → Production (all stacks)"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # The 'production' environment MUST have required-reviewer protection rules
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      {{#each stacks}}
      - name: Deploy {{this.name}} to production
        run: |
          echo "::notice::Deploying {{this.name}} stack to production"
          # ── Replace with your {{this.name}} deployment command ──
          {{#if this.deployCommand}}
          {{this.deployCommand}} --env production
          {{/if}}

      {{/each}}
      {{#if hasDocker}}
      - name: Deploy Docker services to production
        run: |
          echo "::notice::Deploying Docker services to production"
          # ── Replace with your Docker deployment command ──
      {{/if}}

      - name: Set production URL
        id: deploy
        run: echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Post-Deploy Verification ───────────────────────────────────────────────
  verify:
    name: "Post-deploy verification"
    needs: [deploy-production]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run smoke tests
        run: |
          echo "::notice::Running post-deployment smoke tests"
          # ── Replace with your smoke test command ──
          # e.g. curl --fail https://{{name}}.example.com/health
          # e.g. npm run test:smoke

      - name: Notify deployment success
        if: success()
        run: |
          echo "## 🚀 Deployment Complete" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "**Stacks deployed:**" >> "$GITHUB_STEP_SUMMARY"
          {{#each stacks}}
          echo "- ✅ {{this.name}}" >> "$GITHUB_STEP_SUMMARY"
          {{/each}}
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "**Commit:** \`${{"{{"}} github.sha {{"}}"}}\`" >> "$GITHUB_STEP_SUMMARY"
          echo "**Triggered by:** ${{"{{"}} github.actor {{"}}"}}" >> "$GITHUB_STEP_SUMMARY"
  {{/if}}
