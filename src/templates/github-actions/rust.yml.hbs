# ============================================================================
# Rust CI/CD Pipeline — generated by pipeforge
# ============================================================================
# Key design decisions:
#   • Matrix across stable/nightly (or user-specified channels) for compat
#   • Rust builds are expensive — aggressive caching of target/ and registry
#   • clippy with -D warnings treats warnings as errors for strictness
#   • cargo-audit checks Cargo.lock against RustSec Advisory Database
#   • Release builds use --release for optimised binaries in deploy stages
#   • sccache can be layered on top via RUSTC_WRAPPER for even faster builds
# ============================================================================

name: "CI/CD for {{name}}"

on:
  push:
    branches:
      - "{{defaultBranch}}"
    paths-ignore:
      - "**.md"
      - "docs/**"
      - ".github/ISSUE_TEMPLATE/**"
    tags:
      - "v*"
  pull_request:
    branches:
      - "{{defaultBranch}}"
  workflow_dispatch:

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.head_ref || github.ref {{"}}"}}
  cancel-in-progress: true

permissions: read-all

env:
  CARGO_TERM_COLOR: always
  # Incremental compilation is slower in CI — full rebuilds are more cacheable
  CARGO_INCREMENTAL: "0"
  # Backtrace for test failures
  RUST_BACKTRACE: short

jobs:
  # ── Format Check ───────────────────────────────────────────────────────────
  fmt:
    name: "Rustfmt"
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # rustfmt is best run on stable to avoid unstable formatting changes
      - name: Install Rust stable with rustfmt
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt

      - name: Check formatting
        run: cargo fmt --all -- --check

  # ── Clippy ─────────────────────────────────────────────────────────────────
  clippy:
    name: "Clippy (${{"{{"}} matrix.channel {{"}}"}})"
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        channel: [{{#each rustChannels}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust ${{"{{"}} matrix.channel {{"}}"}} with clippy
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: ${{"{{"}} matrix.channel {{"}}"}}
          components: clippy

      # Cache Cargo registry + target dir keyed on Cargo.lock
      - name: Cache Cargo artifacts
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: cargo-clippy-${{"{{"}} matrix.channel {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} hashFiles('**/Cargo.lock') {{"}}"}}
          restore-keys: |
            cargo-clippy-${{"{{"}} matrix.channel {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-

      # -D warnings: treat warnings as errors to enforce clean code
      - name: Run Clippy
        run: cargo clippy --workspace --all-targets --all-features -- -D warnings

  # ── Test ───────────────────────────────────────────────────────────────────
  test:
    name: "Test (${{"{{"}} matrix.channel {{"}}"}})"
    needs: [fmt]
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        channel: [{{#each rustChannels}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust ${{"{{"}} matrix.channel {{"}}"}}
        uses: dtolnay/rust-toolchain@master
        with:
          toolchain: ${{"{{"}} matrix.channel {{"}}"}}

      - name: Cache Cargo artifacts
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: cargo-test-${{"{{"}} matrix.channel {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} hashFiles('**/Cargo.lock') {{"}}"}}
          restore-keys: |
            cargo-test-${{"{{"}} matrix.channel {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-

      - name: Run tests
        run: cargo test --workspace --all-features --verbose

      # Doc tests are separate because they compile differently
      - name: Run doc tests
        run: cargo test --workspace --doc

  # ── Build ──────────────────────────────────────────────────────────────────
  build:
    name: "Build (${{"{{"}} matrix.target {{"}}"}})"
    needs: [clippy, test]
    runs-on: ubuntu-latest
    timeout-minutes: 25
    strategy:
      matrix:
        include:
          - target: x86_64-unknown-linux-gnu
            artifact_name: "{{name}}-linux-amd64"
          - target: aarch64-unknown-linux-gnu
            artifact_name: "{{name}}-linux-arm64"
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust stable
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{"{{"}} matrix.target {{"}}"}}

      - name: Install cross-compilation tools
        if: matrix.target == 'aarch64-unknown-linux-gnu'
        run: |
          sudo apt-get update
          sudo apt-get install -y gcc-aarch64-linux-gnu

      - name: Cache Cargo artifacts
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: cargo-build-${{"{{"}} matrix.target {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-${{"{{"}} hashFiles('**/Cargo.lock') {{"}}"}}
          restore-keys: |
            cargo-build-${{"{{"}} matrix.target {{"}}"}}-${{"{{"}} runner.os {{"}}"}}-

      - name: Build release binary
        run: cargo build --release --target ${{"{{"}} matrix.target {{"}}"}}
        env:
          {{!-- aarch64 cross-compile needs the correct linker --}}
          CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER: aarch64-linux-gnu-gcc

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{"{{"}} matrix.artifact_name {{"}}"}}
          path: target/${{"{{"}} matrix.target {{"}}"}}/release/{{name}}
          retention-days: 5

  # ── Security ───────────────────────────────────────────────────────────────
  security:
    name: "Security audit"
    needs: [fmt]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    continue-on-error: true
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # cargo-audit checks Cargo.lock against the RustSec Advisory Database
      - name: Install cargo-audit
        run: cargo install cargo-audit --locked

      - name: Run cargo-audit
        run: cargo audit

      # cargo-deny checks licenses, bans, and advisories in one pass
      - name: Install cargo-deny
        run: cargo install cargo-deny --locked

      - name: Run cargo-deny
        run: cargo deny check advisories sources
        continue-on-error: true

  {{#if hasDeploy}}
  # ── Deploy to Staging ──────────────────────────────────────────────────────
  deploy-staging:
    name: "Deploy → Staging"
    needs: [build, security]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: "{{name}}-linux-amd64"
          path: bin/

      - name: Deploy to staging
        id: deploy
        run: |
          chmod +x bin/{{name}}
          echo "::notice::Deploying {{name}} to staging environment"
          # ── Replace with your deployment command ──
          # e.g. scp bin/{{name}} staging-host:/opt/{{name}}/
          # e.g. kubectl set image deployment/{{name}} app=image:$GITHUB_SHA
          echo "url=https://staging.{{name}}.example.com" >> "$GITHUB_OUTPUT"

  # ── Deploy to Production ───────────────────────────────────────────────────
  deploy-production:
    name: "Deploy → Production"
    needs: [deploy-staging]
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: production
      url: ${{"{{"}} steps.deploy.outputs.url {{"}}"}}
    permissions:
      contents: read
      id-token: write
      deployments: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifact
        uses: actions/download-artifact@v4
        with:
          name: "{{name}}-linux-amd64"
          path: bin/

      - name: Deploy to production
        id: deploy
        run: |
          chmod +x bin/{{name}}
          echo "::notice::Deploying {{name}} to production environment"
          # ── Replace with your deployment command ──
          echo "url=https://{{name}}.example.com" >> "$GITHUB_OUTPUT"
  {{/if}}
